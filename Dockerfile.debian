FROM node:lts-alpine AS builder

WORKDIR /metube
COPY ui ./
RUN npm ci && \
    export NODE_OPTIONS=--max_old_space_size=2000 && \
    node_modules/.bin/ng build --configuration production


FROM python:3.13-slim-bookworm

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

COPY pyproject.toml uv.lock docker-entrypoint.sh ./

RUN sed -i 's/\r$//g' docker-entrypoint.sh && \
    chmod +x docker-entrypoint.sh && \
    apt-get update && apt-get install -y --no-install-recommends aria2 curl ca-certificates tini gosu wget xz-utils unzip && \
    curl -fsSL https://deno.land/install.sh | sh && \
    ln -s /root/.deno/bin/deno /usr/local/bin/deno && \
    apt-get install -y --no-install-recommends build-essential gcc g++ && \
    pip install uv && \
    uv lock --prerelease allow --upgrade-package yt-dlp && \
    UV_PROJECT_ENVIRONMENT=/usr/local uv sync --frozen --no-dev --compile-bytecode && \
    curl -s https://api.github.com/repos/lexiforest/curl-impersonate/releases/latest | \
    grep '"browser_download_url":' | grep "$(uname -m)-linux-gnu.tar.gz" | grep 'libcurl-' | grep -o 'https://[^"]*' | \
    xargs wget -qO- | tar xvz -C /usr/lib && \
    apt-get purge -y build-essential gcc g++ && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /.cache && chmod 777 /.cache

COPY app ./app
COPY --from=builder /metube/dist/metube ./ui/dist/metube
COPY --from=mwader/static-ffmpeg:8.0.1 /ffmpeg /usr/local/bin/
COPY --from=mwader/static-ffmpeg:8.0.1 /ffprobe /usr/local/bin/

RUN chmod -R 755 ./app

ENV UID=1000
ENV GID=1000
ENV UMASK=022

ENV DOWNLOAD_DIR /downloads
ENV STATE_DIR /downloads/.metube
ENV TEMP_DIR /downloads
VOLUME /downloads
EXPOSE 8090

ARG VERSION=dev
ENV METUBE_VERSION=$VERSION

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "./docker-entrypoint.sh"]

